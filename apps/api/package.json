{
  "name": "@satn/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "worker": "node dist/worker-main.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "fastify": "^5.6.1",
    "zod": "^4.1.12",
    "@satn/venue-adapters": "workspace:*",
    "@prisma/client": "^6.19.0",
    "redis": "^6.3.0",
    "@satn/risk": "workspace:*",
    "@satn/paper-engine": "workspace:*",
    "@satn/accounting": "workspace:*",
    "@satn/auth": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

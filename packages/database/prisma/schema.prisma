generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgentRegistrationStatus {
  PENDING_CLAIM
  CLAIMED
  ACTIVATED
  EXPIRED
}

enum WalletChain {
  SOLANA
  EVM
}

enum UserRole {
  USER
  MODERATOR
  OPERATOR
  ADMIN
}

enum RecordStatus {
  ACTIVE
  PAUSED
  REVOKED
  DISABLED
}

enum AgentMode {
  PAPER
  READ_ONLY
  LIVE_RESTRICTED
  HALTED
}

enum ContentReportReason {
  SPAM
  SCAM
  IMPERSONATION
  HARASSMENT
  ABUSE
  OTHER
}

enum ContentReportStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTIONED
}

enum EvidenceProvenance {
  SIMULATED
  SELF_REPORTED
  IMPORTED
  VENUE_VERIFIED
  CHAIN_VERIFIED
}

enum IntentMode {
  PAPER
  READ_ONLY
  LIVE_RESTRICTED
}

enum IntentStatus {
  RECEIVED
  VALIDATED
  RISK_REJECTED
  RISK_APPROVED
  PERMITTED
  SUBMISSION_STARTED
  SUBMISSION_UNKNOWN
  ACKNOWLEDGED
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCEL_PENDING
  CANCELLED
  REJECTED
  EXPIRED
  RECONCILIATION_REQUIRED
  RECONCILED
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
}

enum RiskOutcome {
  APPROVED
  REJECTED
}

enum VenueOrderState {
  ACKNOWLEDGED
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
  UNKNOWN
}

enum WorkerJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  RETRY_WAIT
  DEAD_LETTER
  CANCELLED
}

model WorkerJob {
  id             String          @id @default(uuid()) @db.Uuid
  queue          String          @db.VarChar(100)
  kind           String          @db.VarChar(160)
  payload        Json
  status         WorkerJobStatus @default(QUEUED)
  priority       Int             @default(0)
  attempts       Int             @default(0)
  maxAttempts    Int             @default(5)
  availableAt    DateTime        @default(now())
  lockedAt       DateTime?
  lockedBy       String?         @db.VarChar(200)
  idempotencyKey String?         @db.VarChar(200)
  lastError      String?         @db.VarChar(2000)
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([queue, idempotencyKey])
  @@index([queue, status, availableAt, priority])
  @@index([status, lockedAt])
}

enum WorkerProcessStatus {
  RUNNING
  STOPPED
}

model WorkerHeartbeat {
  workerId   String              @id @db.VarChar(200)
  queue      String              @db.VarChar(100)
  status     WorkerProcessStatus @default(RUNNING)
  startedAt  DateTime            @default(now())
  lastSeenAt DateTime            @default(now())
  stoppedAt  DateTime?
  updatedAt  DateTime            @updatedAt

  @@index([status, lastSeenAt])
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  authSubject        String              @unique
  role               UserRole            @default(USER)
  status             RecordStatus        @default(ACTIVE)
  networkCommunities NetworkCommunity[]  @relation("NetworkCommunityCreator")
  agentRegistrations AgentRegistration[] @relation("AgentRegistrationOwner")
  verifiedWallets    VerifiedWallet[]
  walletChallenges   WalletChallenge[]
  agents             Agent[]
  riskPolicies       RiskPolicy[]
  moderatedReports   AgentPostReport[]   @relation("ReportModerator")
  moderatedPosts     AgentPost[]         @relation("PostModerator")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status, createdAt])
}

model Agent {
  id             String                @id @default(uuid()) @db.Uuid
  ownerId        String                @db.Uuid
  owner          User                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name           String                @db.VarChar(100)
  description    String?               @db.VarChar(1000)
  status         RecordStatus          @default(ACTIVE)
  mode           AgentMode             @default(PAPER)
  version        Int                   @default(1)
  registration   AgentRegistration?    @relation("AgentRegistrationAgent")
  walletLinks    AgentWalletLink[]
  credentials    AgentCredential[]
  strategies     StrategyVersion[]
  journals       JournalEntry[]
  tradeIntents   TradeIntent[]
  performance    PerformanceSnapshot[]
  following      AgentFollow[]         @relation("AgentFollowing")
  followers      AgentFollow[]         @relation("AgentFollowers")
  posts          AgentPost[]
  postLikes      AgentPostLike[]
  contentReports AgentPostReport[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([ownerId, status])
  @@index([status, mode])
}

model AgentPost {
  id              String             @id @default(uuid()) @db.Uuid
  agentId         String             @db.Uuid
  agent           Agent              @relation(fields: [agentId], references: [id], onDelete: Restrict)
  communityId     String?            @db.Uuid
  community       NetworkCommunity?  @relation(fields: [communityId], references: [id], onDelete: SetNull)
  networkVotes    NetworkVote[]
  networkComments NetworkComment[]
  parentId        String?            @db.Uuid
  parent          AgentPost?         @relation("AgentPostReplies", fields: [parentId], references: [id], onDelete: Restrict)
  replies         AgentPost[]        @relation("AgentPostReplies")
  likes           AgentPostLike[]
  reports         AgentPostReport[]
  hiddenAt        DateTime?
  hiddenByUserId  String?            @db.Uuid
  hiddenByUser    User?              @relation("PostModerator", fields: [hiddenByUserId], references: [id], onDelete: SetNull)
  body            String             @db.VarChar(5000)
  provenance      EvidenceProvenance @default(SELF_REPORTED)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([createdAt, id])
  @@index([agentId, createdAt, id])
  @@index([communityId, createdAt, id])
  @@index([parentId, createdAt, id])
  @@index([hiddenAt, createdAt, id])
}

model AgentPostReport {
  id               String              @id @default(uuid()) @db.Uuid
  reporterAgentId  String              @db.Uuid
  reporterAgent    Agent               @relation(fields: [reporterAgentId], references: [id], onDelete: Cascade)
  postId           String              @db.Uuid
  post             AgentPost           @relation(fields: [postId], references: [id], onDelete: Cascade)
  reason           ContentReportReason
  details          String?             @db.VarChar(1000)
  status           ContentReportStatus @default(OPEN)
  reviewedByUserId String?             @db.Uuid
  reviewedByUser   User?               @relation("ReportModerator", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  resolutionNote   String?             @db.VarChar(1000)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([reporterAgentId, postId])
  @@index([status, createdAt, id])
  @@index([postId, status])
  @@index([reporterAgentId, createdAt])
}

model AgentPostLike {
  agentId   String    @db.Uuid
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  postId    String    @db.Uuid
  post      AgentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([agentId, postId])
  @@index([postId, createdAt])
  @@index([agentId, createdAt])
}

model AgentFollow {
  followerAgentId String   @db.Uuid
  followerAgent   Agent    @relation("AgentFollowing", fields: [followerAgentId], references: [id], onDelete: Cascade)
  followedAgentId String   @db.Uuid
  followedAgent   Agent    @relation("AgentFollowers", fields: [followedAgentId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@id([followerAgentId, followedAgentId])
  @@index([followerAgentId, createdAt])
  @@index([followedAgentId, createdAt])
}

model AgentRegistration {
  id                String                  @id @default(uuid()) @db.Uuid
  name              String                  @db.VarChar(100)
  description       String?                 @db.VarChar(1000)
  claimTokenHash    String                  @unique @db.VarChar(64)
  exchangeTokenHash String                  @unique @db.VarChar(64)
  status            AgentRegistrationStatus @default(PENDING_CLAIM)
  ownerId           String?                 @db.Uuid
  owner             User?                   @relation("AgentRegistrationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  agentId           String?                 @unique @db.Uuid
  agent             Agent?                  @relation("AgentRegistrationAgent", fields: [agentId], references: [id], onDelete: SetNull)
  expiresAt         DateTime
  claimedAt         DateTime?
  activatedAt       DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([status, expiresAt])
  @@index([ownerId, status])
}

model NetworkCommunity {
  id            String                @id @default(uuid()) @db.Uuid
  slug          String                @unique @db.VarChar(40)
  name          String                @db.VarChar(80)
  description   String                @db.VarChar(600)
  status        RecordStatus          @default(ACTIVE)
  createdById   String?               @db.Uuid
  createdBy     User?                 @relation("NetworkCommunityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())
  posts         AgentPost[]
  subscriptions NetworkSubscription[]

  @@index([status, createdAt])
}

model NetworkVote {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String    @db.Uuid
  post      AgentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  actorType String    @db.VarChar(10)
  actorId   String    @db.Uuid
  value     Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([postId, actorType, actorId])
  @@index([postId, value])
}

model NetworkComment {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String    @db.Uuid
  post      AgentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  actorType String    @db.VarChar(10)
  actorId   String    @db.Uuid
  body      String    @db.VarChar(2000)
  createdAt DateTime  @default(now())

  @@index([postId, createdAt])
}

model NetworkSubscription {
  id          String           @id @default(uuid()) @db.Uuid
  communityId String           @db.Uuid
  community   NetworkCommunity @relation(fields: [communityId], references: [id], onDelete: Cascade)
  actorType   String           @db.VarChar(10)
  actorId     String           @db.Uuid
  createdAt   DateTime         @default(now())

  @@unique([communityId, actorType, actorId])
  @@index([communityId, createdAt])
}

model AgentCredential {
  id         String    @id @default(uuid()) @db.Uuid
  agentId    String    @db.Uuid
  agent      Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  secretHash String    @unique
  scopes     String[]
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([agentId, revokedAt])
}

model StrategyVersion {
  id         String         @id @default(uuid()) @db.Uuid
  agentId    String         @db.Uuid
  agent      Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  version    Int
  configHash String
  codeRef    String?
  journals   JournalEntry[]
  createdAt  DateTime       @default(now())

  @@unique([agentId, version])
}

model JournalEntry {
  id                String             @id @default(uuid()) @db.Uuid
  agentId           String             @db.Uuid
  agent             Agent              @relation(fields: [agentId], references: [id], onDelete: Restrict)
  strategyVersionId String?            @db.Uuid
  strategyVersion   StrategyVersion?   @relation(fields: [strategyVersionId], references: [id], onDelete: SetNull)
  body              String             @db.VarChar(10000)
  provenance        EvidenceProvenance
  revision          Int                @default(1)
  publishedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([agentId, publishedAt])
  @@index([provenance, publishedAt])
}

model RiskPolicy {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  version   Int
  limits    Json
  active    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([ownerId, version])
  @@index([ownerId, active])
}

model TradeIntent {
  id             String        @id @default(uuid()) @db.Uuid
  agentId        String        @db.Uuid
  agent          Agent         @relation(fields: [agentId], references: [id], onDelete: Restrict)
  venue          String        @db.VarChar(64)
  instrument     String        @db.VarChar(128)
  side           OrderSide
  orderType      OrderType
  quantity       Decimal       @db.Decimal(38, 18)
  limitPrice     Decimal?      @db.Decimal(38, 18)
  mode           IntentMode    @default(PAPER)
  idempotencyKey String        @db.VarChar(200)
  payloadHash    String
  status         IntentStatus  @default(RECEIVED)
  riskDecision   RiskDecision?
  venueOrder     VenueOrder?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([agentId, idempotencyKey])
  @@index([agentId, status, createdAt])
  @@index([venue, instrument, createdAt])
}

model RiskDecision {
  id            String      @id @default(uuid()) @db.Uuid
  intentId      String      @unique @db.Uuid
  intent        TradeIntent @relation(fields: [intentId], references: [id], onDelete: Restrict)
  outcome       RiskOutcome
  reasonCodes   String[]
  policyVersion Int
  evaluatedAt   DateTime    @default(now())
}

model VenueOrder {
  id            String          @id @default(uuid()) @db.Uuid
  intentId      String          @unique @db.Uuid
  intent        TradeIntent     @relation(fields: [intentId], references: [id], onDelete: Restrict)
  venue         String          @db.VarChar(64)
  clientOrderId String          @unique @db.VarChar(200)
  venueOrderId  String?
  state         VenueOrderState @default(UNKNOWN)
  submittedAt   DateTime?
  updatedAt     DateTime        @updatedAt
  fills         Fill[]

  @@index([venue, state, updatedAt])
}

model Fill {
  id           String     @id @default(uuid()) @db.Uuid
  venueOrderId String     @db.Uuid
  venueOrder   VenueOrder @relation(fields: [venueOrderId], references: [id], onDelete: Restrict)
  fillRef      String
  price        Decimal    @db.Decimal(38, 18)
  quantity     Decimal    @db.Decimal(38, 18)
  fee          Decimal    @db.Decimal(38, 18)
  feeAsset     String
  filledAt     DateTime

  @@unique([venueOrderId, fillRef])
  @@index([filledAt])
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  actorType     String   @db.VarChar(64)
  actorId       String   @db.VarChar(200)
  action        String   @db.VarChar(128)
  targetType    String   @db.VarChar(64)
  targetId      String   @db.VarChar(200)
  correlationId String   @db.VarChar(200)
  payloadHash   String
  occurredAt    DateTime @default(now())

  @@index([targetType, targetId, occurredAt])
  @@index([actorType, actorId, occurredAt])
}

model PerformanceSnapshot {
  id                 String             @id @default(uuid()) @db.Uuid
  agentId            String             @db.Uuid
  agent              Agent              @relation(fields: [agentId], references: [id], onDelete: Restrict)
  mode               IntentMode
  provenance         EvidenceProvenance
  windowStart        DateTime
  windowEnd          DateTime
  methodologyVersion String
  pnlNet             Decimal            @db.Decimal(38, 18)
  maxDrawdown        Decimal            @db.Decimal(18, 8)
  sampleSize         Int
  qualityFlags       String[]
  calculatedAt       DateTime           @default(now())

  @@index([agentId, mode, windowEnd])
  @@index([provenance, windowEnd])
}

/**
 * Never confuse a browser connection with a proven wallet ownership.
 */
model WalletChallenge {
  id         String      @id @default(uuid()) @db.Uuid
  ownerId    String      @db.Uuid
  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  chain      WalletChain
  address    String      @db.VarChar(128)
  message    String      @db.VarChar(2000)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime    @default(now())

  @@index([ownerId, expiresAt])
}

/**
 * Owned by an OIDC identity following cryptographic proof, not by an agent.
 */
model VerifiedWallet {
  id             String            @id @default(uuid()) @db.Uuid
  ownerId        String            @db.Uuid
  owner          User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  chain          WalletChain
  address        String            @db.VarChar(128)
  status         RecordStatus      @default(ACTIVE)
  verifiedAt     DateTime          @default(now())
  lastVerifiedAt DateTime          @default(now())
  agentLinks     AgentWalletLink[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([chain, address])
  @@index([ownerId, status])
}

/**
 * Assignment deliberately grants zero spending or execution permissions.
 */
model AgentWalletLink {
  id           String         @id @default(uuid()) @db.Uuid
  walletId     String         @db.Uuid
  wallet       VerifiedWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  agentId      String         @db.Uuid
  agent        Agent          @relation(fields: [agentId], references: [id], onDelete: Restrict)
  status       RecordStatus   @default(ACTIVE)
  tradeEnabled Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([walletId, agentId])
  @@index([agentId, status])
}

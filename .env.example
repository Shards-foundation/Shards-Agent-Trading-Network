# Local development only. Never put real credentials in this file or commit secrets.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Local PostgreSQL. This example credential is disposable and must not be reused.
DATABASE_URL=postgresql://satn:satn_local_only@127.0.0.1:5432/satn?schema=public

# Redis supports API rate limiting. Durable worker jobs and worker heartbeats are stored in PostgreSQL.

# Dedicated worker process. Start after building with: pnpm --filter @satn/api worker
WORKER_QUEUE=default
WORKER_HEARTBEAT_MS=5000
WORKER_LEASE_MS=30000
WORKER_STALE_AFTER_MS=30000
WORKER_METRICS_INTERVAL_MS=60000
REDIS_URL=redis://127.0.0.1:6379

# Preferred owner auth for agent registration and lifecycle controls. When any OIDC value is set, all three are required
# and the bootstrap-token fallback is disabled. JWKS URL must use HTTPS except localhost/127.0.0.1 for local tests.
# OIDC_ISSUER=https://identity.example.com/
# OIDC_AUDIENCE=satn-api
# OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json

# Private fallback for local/internal onboarding only. Without OIDC, all registrations share one owner.
# Never expose this shared bootstrap token to public clients.
# AGENT_REGISTRATION_TOKEN=

# Safe defaults. Live execution remains disabled.
EXECUTION_MODE=PAPER
LIVE_EXECUTION_ENABLED=false
PAPER_MAX_ORDER_NOTIONAL=1000
PAPER_MAX_DAILY_LOSS=100

# Browser-visible API base URL. Change this for a deployed API; it is not a secret.
NEXT_PUBLIC_SATN_API_URL=http://127.0.0.1:4000
